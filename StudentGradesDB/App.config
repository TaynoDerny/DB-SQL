<?xml version="1.0" encoding="utf-8" ?>
<configuration>
	<connectionStrings>
		<add name="SqlServerDB"
			 connectionString="Data Source=(localdb)\MSSQLLocalDB;Initial Catalog=StudentGradesDB;Integrated Security=True;"
			 providerName="System.Data.SqlClient" />
		<add name="SqliteDB"
			 connectionString="Data Source=StudentGrades.db;"
			 providerName="System.Data.SQLite" />
	</connectionStrings>
</configuration>